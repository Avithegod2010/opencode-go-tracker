# Copy to .env or set as environment variables
# Personal API key (Account > Personal API keys) or Service account key (Settings > Service accounts)
# For logger: needs Models > Request. For future Usage:Read polling: Usage > Read
OPENCODE_API_KEY=oc_sk_...

# Base URL - inference (paid/balance) vs Go
# Paid/balance: https://opencode.ai/inference
# Go:          https://opencode.ai/inference/go
# Teams Go:    same as Go (per-member limits)
OPENCODE_BASE_URL=https://opencode.ai/inference

# Optional: default model for logger
OPENCODE_MODEL=kimi-k3

# Logger outputs
OPENCODE_DB=opencode_usage.db
OPENCODE_CSV=usage_log.csv
