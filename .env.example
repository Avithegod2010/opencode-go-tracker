# Copy to .env or set as environment variables. .env is gitignored.
# Personal API key (Account > Personal API keys) or Service account key (Settings > Service accounts)
# Needs Models > Request. Keys are never stored in the tracker DB.
OPENCODE_API_KEY=oc_sk_...

# Base URL - inference (paid/balance) vs Go
# Paid/balance: https://opencode.ai/inference
# Go:          https://opencode.ai/inference/go
# Teams Go:    same as Go (per-member limits)
OPENCODE_BASE_URL=https://opencode.ai/inference/go

# Defaults used by the logger/proxy/import labels
OPENCODE_MODEL=kimi-k3
OPENCODE_PLAN=go
OPENCODE_PROFILE=
OPENCODE_MEMBER=
OPENCODE_PROJECT=
# Retries for 5xx/network failures (4xx is never retried)
OPENCODE_RETRIES=2

# OpenCode client session DB (auto-detected if blank)
# Windows: C:\Users\<you>\.local\share\opencode\opencode.db
OPENCODE_CLIENT_DB=

# Go billing period renewal day (1 = calendar month)
OPENCODE_PERIOD_START_DAY=1

# Logger/proxy outputs (local, gitignored)
OPENCODE_DB=opencode_usage.db
OPENCODE_CSV=usage_log.csv
OPENCODE_LIMITS_CACHE=go_limits_cache.json

# Optional security/network overrides
# /api/* token. Leave unset to have the server generate one on first start
# (saved 0600 under the user config dir and printed once). Set it for
# headless/CI use; callers send it as X-Tracker-Token or ?token=.
TRACKER_API_TOKEN=
# Extra hostnames allowed to reach the local API (e.g. a LAN DNS name)
OPENCODE_ALLOWED_HOSTS=
# Extra HTTPS hosts the web logger may forward keys to (default: opencode.ai)
OPENCODE_ALLOWED_BASE_HOSTS=
